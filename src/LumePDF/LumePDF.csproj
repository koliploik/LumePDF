<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>LumePDF</RootNamespace>
    <AssemblyName>LumePDF</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LumePDF.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLower())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Product>LumePDF</Product>
    <Description>Lettore PDF leggero</Description>
  </PropertyGroup>

  <!-- Publish = Native AOT: one small exe, no .NET runtime to install, fast cold start.
       Still needs the (Microsoft-signed, shared) Windows App Runtime 1.8. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\LumePDF.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged publish leaves out the compiled XAML (.xbf) and resource index (.pri),
       without which the window fails to load. -->
  <Target Name="CopyXamlResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LumePDFXamlOutput Include="$(OutDir)*.xbf;$(OutDir)$(TargetName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_LumePDFXamlOutput)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
