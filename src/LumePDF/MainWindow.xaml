<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumePDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumePDF"
    Title="LumePDF">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="HeaderToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / title bar -->
        <Grid x:Name="Header" ColumnSpacing="4" Padding="6,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionSpace" Width="140" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="LeftTools" Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource HeaderButton}" Click="Open_Click" ToolTipService.ToolTip="Apri (Ctrl+O)" AutomationProperties.Name="Apri">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                </Button>
                <ToggleButton x:Name="OutlineToggle" Style="{StaticResource HeaderToggle}" Visibility="Collapsed"
                              Click="OutlineToggle_Click" ToolTipService.ToolTip="Indice" AutomationProperties.Name="Indice">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent">
                <TextBlock x:Name="TitleText" Text="LumePDF" VerticalAlignment="Center" Margin="8,0"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel x:Name="DocTools" Grid.Column="2" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Cerca" Width="220" VerticalAlignment="Center" PlaceholderText="Cerca nel documento"
                         KeyDown="SearchBox_KeyDown" />
                <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Width="76" TextAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="PrevHit" Style="{StaticResource HeaderButton}" Click="PrevHit_Click"
                        ToolTipService.ToolTip="Precedente (Maiusc+F3)" AutomationProperties.Name="Precedente" IsEnabled="False">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Button x:Name="NextHit" Style="{StaticResource HeaderButton}" Click="NextHit_Click"
                        ToolTipService.ToolTip="Successivo (F3)" AutomationProperties.Name="Successivo" IsEnabled="False">
                    <FontIcon Glyph="&#xE70D;" FontSize="14" />
                </Button>

                <AppBarSeparator x:Name="Sep1" VerticalAlignment="Center" />

                <TextBox x:Name="PageBox" Width="56" VerticalAlignment="Center" TextAlignment="Center"
                         KeyDown="PageBox_KeyDown" LostFocus="PageBox_LostFocus" ToolTipService.ToolTip="Vai a pagina (Ctrl+G)" AutomationProperties.Name="Vai a pagina" />
                <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <AppBarSeparator x:Name="Sep2" VerticalAlignment="Center" />

                <Button x:Name="ZoomOutButton" Style="{StaticResource HeaderButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Riduci (Ctrl+-)" AutomationProperties.Name="Riduci">
                    <FontIcon Glyph="&#xE71F;" FontSize="16" />
                </Button>
                <DropDownButton x:Name="ZoomButton" AutomationProperties.Name="Zoom" VerticalAlignment="Center" Width="112"
                                Background="Transparent" BorderBrush="Transparent">
                    <TextBlock x:Name="ZoomText" Text="100%" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Adatta larghezza" Tag="w" KeyboardAcceleratorTextOverride="Ctrl+1" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="Adatta pagina" Tag="p" KeyboardAcceleratorTextOverride="Ctrl+2" Click="ZoomPreset_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="50%" Tag="0.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="75%" Tag="0.75" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="100%" Tag="1" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="125%" Tag="1.25" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="150%" Tag="1.5" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="200%" Tag="2" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="300%" Tag="3" Click="ZoomPreset_Click" />
                            <MenuFlyoutItem Text="400%" Tag="4" Click="ZoomPreset_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ZoomInButton" Style="{StaticResource HeaderButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Ingrandisci (Ctrl++)" AutomationProperties.Name="Ingrandisci">
                    <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="OutlineTree" SelectionMode="None" ItemInvoked="OutlineTree_ItemInvoked" Padding="4,0" />

            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                  CornerRadius="8,0,0,0">

                <ScrollViewer x:Name="Scroller" Visibility="Collapsed" IsTabStop="True"
                              HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto" ZoomMode="Disabled"
                              ViewChanged="Scroller_ViewChanged" SizeChanged="Scroller_SizeChanged">
                    <Grid x:Name="ScrollContent" Background="Transparent" PointerWheelChanged="ScrollContent_PointerWheelChanged">
                        <ItemsRepeater x:Name="Pages" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalCacheLength="1" />
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="Welcome" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Width="520" Margin="24,48" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="LumePDF" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Trascina qui un PDF, oppure" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Apri file…" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                                Click="Open_Click" />
                        <TextBlock x:Name="RecentHeader" Text="Recenti" Margin="0,24,0,0"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="RecentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RecentFile">
                                    <StackPanel Padding="0,6" ToolTipService.ToolTip="{x:Bind Path}" AutomationProperties.Name="{x:Bind Path}">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <ProgressRing x:Name="Busy" IsActive="False" Width="40" Height="40" />
            </Grid>
        </Grid>
    </Grid>
</Window>
