<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the code that doesn't need a window: layout math, text layer, selection, menu
       rules, and the PDFium wrapper against real files. The app is a WinUI executable a plain
       test host can't load, so the files under test are compiled in here directly. Not part of
       the published app: the workflow only publishes src/LumePDF. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LumePDF.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LumePDF\Pdf\*.cs" Link="App\Pdf\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\LumePDF\Viewer\PageGeometry.cs" Link="App\Viewer\PageGeometry.cs" />
    <Compile Include="..\..\src\LumePDF\Viewer\PageMenu.cs" Link="App\Viewer\PageMenu.cs" />
    <Compile Include="..\..\src\LumePDF\Viewer\TextSelection.cs" Link="App\Viewer\TextSelection.cs" />
    <Compile Include="..\..\src\LumePDF\Recents.cs" Link="App\Recents.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\test.pdf" Link="samples\test.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
